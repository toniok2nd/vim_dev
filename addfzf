#!/bin/bash
set -e

BASHRC="$HOME/.bashrc"

# --- Your functions content ---
read -r -d '' FUNCTIONS_BLOCK <<'EOF'
myfcd() {
    local start_dir
    start_dir="${1:-$(pwd)}"
    local selected
    selected=$(find "$start_dir" -mindepth 1 -type d 2>/dev/null |
        fzf -m \
            --preview 'ls -al --color=always {}' \
            --bind 'enter:execute(echo "cd $(printf %q {})")+abort')
    if [[ -n $selected ]]; then
        eval -- "$selected"
    fi
}

myfzf() {
    ls "$@" | fzf -m | fzf --sync -x -m \
        --preview-window=right:70%:border \
        --bind "ctrl-space:preview([ -x \"\$(command -v bat)\" ] && bat --style=numbers --color=always {} || [ -x \"\$(command -v batcat)\" ] && batcat --style=numbers --color=always {} || cat {})" \
        --bind "ctrl-g:preview(git log --oneline --decorate --graph --all 2>&1 || echo 'Not a git repo')" \
        --bind "alt-i:preview(ls -al --color=always)" \
        --bind "ctrl-s:preview([ -x \"\$(command -v ccze)\" ] && stat {} | ccze -A || stat {})" \
        --bind "enter:execute(vim -p {+})" \
        --header "tab: select | ctrl‑space: preview | ctrl‑g: git log | alt‑i: ls | ctrl‑s: stat | enter: edit"
}

export -f myfcd
export -f myfzf
EOF

# --- Helpers ---
has_func() {
  local name="$1"
  # Checks either "name()" or "function name" style.
  grep -Eq "^[[:space:]]*((${name})[[:space:]]*\(\)|function[[:space:]]+${name}\b)" "$BASHRC"
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

install_pkg() {
  local pkg="$1"
  local cmd_hint="$2"   # for logging only
  local did_install=0

  if have_cmd apt-get; then
    sudo apt-get update -y
    sudo apt-get install -y "$pkg"
    did_install=1
  elif have_cmd dnf; then
    sudo dnf install -y "$pkg"
    did_install=1
  elif have_cmd yum; then
    sudo yum install -y "$pkg"
    did_install=1
  elif have_cmd pacman; then
    sudo pacman -Sy --noconfirm "$pkg"
    did_install=1
  elif have_cmd zypper; then
    sudo zypper --non-interactive install "$pkg"
    did_install=1
  elif have_cmd brew; then
    brew install "$pkg"
    did_install=1
  else
    echo "No supported package manager found. Please install ${cmd_hint} manually."
    return 1
  fi

  return $did_install
}

# --- Ensure fzf ---
if ! have_cmd fzf; then
  echo "[*] fzf not found. Installing..."
  # Common package names across distros:
  # Debian/Ubuntu: fzf ; Fedora: fzf ; Arch: fzf
  # We'll just try "fzf".
  install_pkg "fzf" "fzf"
fi

# --- Ensure ccze ---
if ! have_cmd ccze; then
  echo "[*] ccze not found. Installing..."
  # Common package names:
  # Debian/Ubuntu: ccze ; Fedora/RHEL: ccze ; Arch: ccze
  # We'll try "ccze".
  install_pkg "ccze" "ccze"
fi

# --- Ensure functions in ~/.bashrc ---
touch "$BASHRC"

need_append=0
if ! has_func "myfcd"; then
  need_append=1
fi
if ! has_func "myfzf"; then
  need_append=1
fi

if [[ "$need_append" -eq 1 ]]; then
  echo "[*] Adding functions to $BASHRC ..."
  {
    echo ""
    echo "# --- Added by setup_fzf_functions.sh ---"
    echo "$FUNCTIONS_BLOCK"
    echo "# --- End Added by setup_fzf_functions.sh ---"
  } >> "$BASHRC"
else
  echo "[*] Functions already exist in $BASHRC. Nothing to add."
fi

# --- Source bashrc ---
echo "[*] Sourcing $BASHRC ..."
# shellcheck disable=SC1090
source "$BASHRC"

echo "[+] Done."
